{
  "name": "inventory-booking-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "svelte-kit sync && vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "prettier --check .",
    "generate:api-types": "npm exec --yes --package openapi-typescript@7.13.0 -- openapi-typescript src/lib/api/openapi.json -o src/lib/api/generated.ts && prettier --write src/lib/api/generated.ts src/lib/api/openapi.json"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.5.6",
    "@sveltejs/kit": "^2.15.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@types/qrcode": "^1.5.6",
    "prettier": "^3.4.2",
    "prettier-plugin-svelte": "^3.3.2",
    "svelte": "^5.15.0",
    "svelte-check": "^4.1.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  },
  "overrides": {
    "cookie": "1.1.1"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4"
  }
}
